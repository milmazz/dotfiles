# Homebrew Bundle -- run `brew bundle --global` to install (reads ~/.Brewfile).
#
# Shared packages come first. The "Personal machine only" block at the bottom is
# rendered when chezmoi's `machine` data value is "personal" (asked once by
# `chezmoi init`; see .chezmoi.toml.tmpl). Work/internal packages live in
# ~/.Brewfile.local (gitignored, not synced). Taps are omitted: homebrew/core,
# homebrew/cask, homebrew/bundle and homebrew/services are built into Homebrew.
{{- /* `and` short-circuits, so a missing key (e.g. CI, or a config generated
       before this prompt existed) safely counts as work. */ -}}
{{- $personal := and (hasKey . "machine") (eq .machine "personal") }}

# Shell & prompt
brew "fish"
brew "fisher"
brew "bash"
brew "starship" # prompt
brew "zoxide"   # smarter cd (z / zi)
brew "atuin"    # shell history (Ctrl-R), optional e2e-encrypted sync

# Runtime / version manager (replaces asdf, pyenv, kerl)
brew "mise"

# Languages & runtimes
brew "go"

# Editor
brew "neovim"
brew "tree-sitter-cli" # nvim-treesitter (main branch) needs it to build parsers

# Git
brew "git"
brew "gh"
brew "git-delta"
brew "git-filter-repo"
brew "lazygit"

# Search / files / shell utils
brew "bat"
brew "fd"
brew "fzf"
brew "ripgrep"
brew "tree"
brew "sponge"
brew "gnu-sed"
brew "jq"
brew "yq"
brew "htop"
brew "ctags"
brew "curl"
brew "wget"
brew "tmux"
brew "rename"

# Task runners / dev workflow
brew "just"
brew "uv"
brew "chezmoi"
brew "caddy"

# Linters / formatters
brew "shellcheck"
brew "yamllint"
brew "markdownlint-cli"
brew "markdownlint-cli2"
brew "prettier"
brew "harper" # grammar checker (LSP)
brew "actionlint"
brew "typos-cli"
brew "ast-grep"

# Kubernetes / cloud
brew "k9s"
brew "awscli"

# Databases
brew "postgresql@18", restart_service: :changed, link: true
brew "libpq"
brew "duckdb"
brew "memcached", restart_service: :changed

# GnuPG
brew "gnupg"

# Docs / rendering / misc
brew "graphviz"
brew "pandoc"
brew "poppler"
brew "wxwidgets"
brew "epubcheck"

# Casks
cask "ghostty"

{{- if $personal }}

# --- Personal machine only ----------------------------------------------------
tap "docker/tap"

# Cloud / services
brew "flyctl"
brew "localstack"
brew "docker-compose"
brew "k6"
brew "bazelisk"

# Databases
brew "postgis" # bier (open-source library) development; depends on libpq only

# JavaScript
brew "yarn"

# LLMs
brew "ollama"

# Duplicate-file finders
brew "czkawka"
brew "fclones"

# Docs
brew "markdown-toc"

# Casks
cask "vlc"
cask "docker/tap/sbx"
{{- end }}
